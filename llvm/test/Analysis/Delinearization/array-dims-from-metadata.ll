; RUN: opt < %s -passes="print<delinearization>" -disable-output 2>&1 | FileCheck %s

; Test that delinearization reads array.dims metadata when available.

; C array with metadata: int arr[10][20]
@c_array = global [10 x [20 x i32]] zeroinitializer, !array.dims !0

; Fortran array with metadata: real arr(5, 10)
@fortran_array = global [10 x [5 x double]] zeroinitializer, !array.dims !1

; Array without metadata (fallback to type-based extraction)
@no_metadata_array = global [15 x [25 x i32]] zeroinitializer

; A valid one-dimensional shape must not require two pre-existing sizes.
@one_dimensional_array = global [100 x i32] zeroinitializer, !array.dims !2

; Incomplete metadata must be ignored as a whole, not used as a partial shape.
@incomplete_metadata_array = global [10 x [20 x i32]] zeroinitializer, !array.dims !3

; Symbolic loop strides cannot be recovered by the constant-stride fallback.
@symbolic_stride_array = global [1000 x i32] zeroinitializer, !array.dims !4

; A zero extent is malformed and must force conservative fallback.
@malformed_metadata_array = global [10 x [20 x i32]] zeroinitializer, !array.dims !5

define void @test_c_array_metadata(i64 %i, i64 %j) {
; CHECK-LABEL: 'test_c_array_metadata'
; CHECK-NEXT:  Inst: %v = load i32, ptr %arrayidx, align 4
; CHECK-NEXT:  AccessFunction: {{\{\{}}0,+,80}<nuw><nsw><%for.i>,+,4}<nuw><nsw><%for.j>
; CHECK-NEXT:  Base offset: @c_array
; CHECK-NEXT:  ArrayDecl[10][20] with elements of 4 bytes.
; CHECK-NEXT:  ArrayRef[{0,+,1}<nuw><nsw><%for.i>][{0,+,1}<nuw><nsw><%for.j>]
; CHECK-NEXT:  Delinearization validation: Succeeded
;
entry:
  br label %for.i

for.i:
  %i.iv = phi i64 [ 0, %entry ], [ %i.next, %for.i.inc ]
  br label %for.j

for.j:
  %j.iv = phi i64 [ 0, %for.i ], [ %j.next, %for.j.inc ]
  %arrayidx = getelementptr inbounds [10 x [20 x i32]], ptr @c_array, i64 0, i64 %i.iv, i64 %j.iv
  %v = load i32, ptr %arrayidx, align 4
  br label %for.j.inc

for.j.inc:
  %j.next = add nuw nsw i64 %j.iv, 1
  %j.cmp = icmp ult i64 %j.next, 20
  br i1 %j.cmp, label %for.j, label %for.i.inc

for.i.inc:
  %i.next = add nuw nsw i64 %i.iv, 1
  %i.cmp = icmp ult i64 %i.next, 10
  br i1 %i.cmp, label %for.i, label %exit

exit:
  ret void
}

