; RUN: opt < %s -passes="print<delinearization>" -disable-output 2>&1 | FileCheck %s

; Test that delinearization reads array.dims metadata when available.

; C array with metadata: int arr[10][20]
@c_array = global [10 x [20 x i32]] zeroinitializer, !array.dims !0

; Fortran array with metadata: real arr(5, 10)
@fortran_array = global [10 x [5 x double]] zeroinitializer, !array.dims !1

; Array without metadata (fallback to type-based extraction)
@no_metadata_array = global [15 x [25 x i32]] zeroinitializer

define void @test_c_array_metadata(i64 %i, i64 %j) {
; CHECK-LABEL: 'test_c_array_metadata'
; CHECK-NEXT:  Inst: %v = load i32, ptr %arrayidx, align 4
; CHECK-NEXT:  AccessFunction: {{\{\{}}0,+,80}<nuw><nsw><%for.i>,+,4}<nuw><nsw><%for.j>
; CHECK-NEXT:  Base offset: @c_array
; CHECK-NEXT:  ArrayDecl[10][20] with elements of 4 bytes.
; CHECK-NEXT:  ArrayRef[{0,+,1}<nuw><nsw><%for.i>][{0,+,1}<nuw><nsw><%for.j>]
; CHECK-NEXT:  Delinearization validation: Succeeded
;
entry:
  br label %for.i

for.i:
  %i.iv = phi i64 [ 0, %entry ], [ %i.next, %for.i.inc ]
  br label %for.j

for.j:
  %j.iv = phi i64 [ 0, %for.i ], [ %j.next, %for.j.inc ]
  %arrayidx = getelementptr inbounds [10 x [20 x i32]], ptr @c_array, i64 0, i64 %i.iv, i64 %j.iv
  %v = load i32, ptr %arrayidx, align 4
  br label %for.j.inc

for.j.inc:
  %j.next = add nuw nsw i64 %j.iv, 1
  %j.cmp = icmp ult i64 %j.next, 20
  br i1 %j.cmp, label %for.j, label %for.i.inc

for.i.inc:
  %i.next = add nuw nsw i64 %i.iv, 1
  %i.cmp = icmp ult i64 %i.next, 10
  br i1 %i.cmp, label %for.i, label %exit

exit:
  ret void
}

define void @test_fortran_array_metadata(i64 %i, i64 %j) {
; CHECK-LABEL: 'test_fortran_array_metadata'
; CHECK-NEXT:  Inst: %v = load double, ptr %arrayidx, align 8
; CHECK-NEXT:  AccessFunction: {{\{\{}}0,+,8}<nuw><nsw><%for.i>,+,40}<nuw><nsw><%for.j>
; CHECK-NEXT:  Base offset: @fortran_array
; CHECK-NEXT:  ArrayDecl[10][5] with elements of 8 bytes.
; CHECK-NEXT:  ArrayRef[{0,+,1}<nuw><nsw><%for.j>][{0,+,1}<nuw><nsw><%for.i>]
; CHECK-NEXT:  Delinearization validation: Succeeded
;
; Subscripts are 0-based (memory layout order), matching GEP indices [j][i].
entry:
  br label %for.i

for.i:
  %i.iv = phi i64 [ 0, %entry ], [ %i.next, %for.i.inc ]
  br label %for.j

for.j:
  %j.iv = phi i64 [ 0, %for.i ], [ %j.next, %for.j.inc ]
  %arrayidx = getelementptr inbounds [10 x [5 x double]], ptr @fortran_array, i64 0, i64 %j.iv, i64 %i.iv
  %v = load double, ptr %arrayidx, align 8
  br label %for.j.inc

for.j.inc:
  %j.next = add nuw nsw i64 %j.iv, 1
  %j.cmp = icmp ult i64 %j.next, 10
  br i1 %j.cmp, label %for.j, label %for.i.inc

for.i.inc:
  %i.next = add nuw nsw i64 %i.iv, 1
  %i.cmp = icmp ult i64 %i.next, 5
  br i1 %i.cmp, label %for.i, label %exit

exit:
  ret void
}

define void @test_no_metadata_fallback(i64 %i, i64 %j) {
; CHECK-LABEL: 'test_no_metadata_fallback'
; CHECK-NEXT:  Inst: %v = load i32, ptr %arrayidx, align 4
; CHECK-NEXT:  AccessFunction: {{\{\{}}0,+,100}<nuw><nsw><%for.i>,+,4}<nuw><nsw><%for.j>
; CHECK-NEXT:  Base offset: @no_metadata_array
; CHECK-NEXT:  ArrayDecl[UnknownSize][25] with elements of 4 bytes.
; CHECK-NEXT:  ArrayRef[{0,+,1}<nuw><nsw><%for.i>][{0,+,1}<nuw><nsw><%for.j>]
; CHECK-NEXT:  Delinearization validation: Succeeded
;
entry:
  br label %for.i

for.i:
  %i.iv = phi i64 [ 0, %entry ], [ %i.next, %for.i.inc ]
  br label %for.j

for.j:
  %j.iv = phi i64 [ 0, %for.i ], [ %j.next, %for.j.inc ]
  %arrayidx = getelementptr inbounds [15 x [25 x i32]], ptr @no_metadata_array, i64 0, i64 %i.iv, i64 %j.iv
  %v = load i32, ptr %arrayidx, align 4
  br label %for.j.inc

for.j.inc:
  %j.next = add nuw nsw i64 %j.iv, 1
  %j.cmp = icmp ult i64 %j.next, 25
  br i1 %j.cmp, label %for.j, label %for.i.inc

for.i.inc:
  %i.next = add nuw nsw i64 %i.iv, 1
  %i.cmp = icmp ult i64 %i.next, 15
  br i1 %i.cmp, label %for.i, label %exit

exit:
  ret void
}

; C array sizes: 10, 20
!0 = !{i64 10, i64 20}

; Fortran array sizes in memory layout order (column-major reverses dimensions).
; Source: real arr(5, 10) → Memory: [10 x [5 x ...]] → Metadata sizes: 10, 5
!1 = !{i64 10, i64 5}
