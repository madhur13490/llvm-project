; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -disable-output "-passes=print<da>" -aa-pipeline=basic-aa 2>&1 \
; RUN: | FileCheck %s

; A(m, n) with a runtime leading extent smax(0, m), as a Fortran dummy array
; is laid out, accessed as A(j, i) = A(j, i) * 2. The in-range guarantee
; states extents that are only known at run time. The range check
; is skipped under the guarantee, but the overflow reasoning after it cannot be
; discharged for a runtime extent even though the guarantee already implies
; it; skipping that too recovers the shape and makes the dependence exact.
define void @runtime_extent(ptr noalias %A, i64 %m, i64 %n) {
; CHECK-LABEL: 'runtime_extent'
; CHECK-NEXT:  Src: %v = load double, ptr %p, align 8 --> Dst: %v = load double, ptr %p, align 8
; CHECK-NEXT:    da analyze - none!
; CHECK-NEXT:  Src: %v = load double, ptr %p, align 8 --> Dst: store double %w, ptr %p, align 8
; CHECK-NEXT:    da analyze - anti [0 0|<]!
; CHECK-NEXT:  Src: store double %w, ptr %p, align 8 --> Dst: store double %w, ptr %p, align 8
; CHECK-NEXT:    da analyze - none!
;
entry:
  %ext = call i64 @llvm.smax.i64(i64 %m, i64 0)
  %A.c = call ptr @llvm.assume.chained.p0(ptr %A)
      [ "array.extents"(i64 %ext, i64 %n) ]
  br label %outer

outer:
  %i = phi i64 [ 1, %entry ], [ %i.next, %outer.latch ]
  %im1 = add nsw i64 %i, -1
  %off = mul nuw nsw i64 %im1, %ext
  %row = getelementptr [8 x i8], ptr %A.c, i64 %off
  br label %inner

inner:
  %j = phi i64 [ 1, %outer ], [ %j.next, %inner ]
  %jm1 = add nsw i64 %j, -1
  %p = getelementptr [8 x i8], ptr %row, i64 %jm1
  %v = load double, ptr %p, align 8
  %w = fmul double %v, 2.0
  store double %w, ptr %p, align 8
  %j.next = add nuw nsw i64 %j, 1
  %j.done = icmp eq i64 %j, %m
  br i1 %j.done, label %outer.latch, label %inner

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %i.done = icmp eq i64 %i, %n
  br i1 %i.done, label %exit, label %outer

exit:
  ret void
}

declare i64 @llvm.smax.i64(i64, i64)

declare ptr @llvm.assume.chained.p0(ptr)
