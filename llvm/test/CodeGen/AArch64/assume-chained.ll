; llvm.assume.chained only states facts, so it lowers to its operand.
define i32 @load_through_chain(ptr %a, i64 %i, i64 %n) {
; SDAG-LABEL: load_through_chain:
; SDAG:       // %bb.0:
; SDAG-NEXT:    ldr w0, [x0, x1, lsl #2]
; SDAG-NEXT:    ret
;
; FAST-LABEL: load_through_chain:
; FAST:       // %bb.0:
; FAST-NEXT:    mov x8, #4 // =0x4
; FAST-NEXT:    mul x8, x1, x8
; FAST-NEXT:    add x8, x0, x8
; FAST-NEXT:    ldr w0, [x8]
; FAST-NEXT:    ret
;
; GISEL-LABEL: load_through_chain:
; GISEL:       // %bb.0:
; GISEL-NEXT:    ldr w0, [x0, x1, lsl #2]
; GISEL-NEXT:    ret
  %c = call ptr @llvm.assume.chained.p0(ptr %a) [ "array.extents"(i64 %n) ]
  %p = getelementptr i32, ptr %c, i64 %i
  %v = load i32, ptr %p, align 4
  ret i32 %v
}

